{
  "name": "goviral-desktop",
  "productName": "GoViral",
  "version": "1.1.0-beta.1",
  "description": "GoViral for Windows and Mac",
  "author": "GoViral <hello@govirall.now>",
  "homepage": "https://app.govirall.now/download",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.cjs",
    "check": "node scripts/check.cjs",
    "dist:win": "electron-builder --config electron-builder.config.js --win nsis --x64 --arm64",
    "dist:win:x64": "electron-builder --config electron-builder.config.js --win nsis --x64",
    "dist:mac": "electron-builder --config electron-builder.config.js --mac",
    "release": "electron-builder --config electron-builder.config.js --publish always",
    "test:tiktok": "node scripts/tiktok-unit.cjs",
    "harness:tiktok": "electron scripts/tiktok-harness.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
